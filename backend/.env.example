# App Settings
APP_NAME=Smart Learning Platform API
ENVIRONMENT=development
DEBUG=True

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# SMTP Email & OTP Settings (Mã OTP sống 10 phút)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@smartlearning.com
SMTP_FROM_NAME=Smart Learning Platform
OTP_EXPIRE_MINUTES=10

# Database Settings
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=classroom_db
DATABASE_URL=postgresql+psycopg2://app_user:app_password@localhost:5432/classroom_db

# CORS Origins
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

# JWT Auth Settings
SECRET_KEY=change-me-to-a-secure-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase Storage Settings
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_or_service_key
SUPABASE_BUCKET=smart-learning-bucket

# Google Gemini / AI Chat Settings
GOOGLE_API_KEY=your_google_gemini_api_key_here
